include ../include.mk

include ../erlang_deps.mk

all-local: $(EBIN_DIR) $(EBIN_DIR)/yaws.app $(EBIN_DIR)/yaws.appup $(EBIN_FILES)

tags: $(EBIN_DIR)/yaws_generated.beam $(EBIN_DIR)/yaws_debug.beam
	$(AM_V_GEN)erl  -noshell -pa $(EBIN_DIR) -s yaws_debug mktags

xref: $(EBIN_DIR)/yaws_generated.beam $(EBIN_DIR)/yaws_debug.beam
	$(AM_V_GEN)erl -noshell -pa $(EBIN_DIR) -s yaws_debug xref $(EBIN_DIR)

clean-local:
	$(AM_V_at)rm -f $(EBIN_DIR)/yaws.app $(EBIN_DIR)/yaws.appup $(EBIN_FILES)
	$(AM_V_at)rm -f yaws_generated.erl mime_types.erl

yaws_generated.erl: ./yaws_generated.template ../vsn.mk \
		    $(EBIN_DIR)/yaws.beam
	$(AM_V_at)(cd . &&	\
	  YAWS_VSN='2.3.1'		\
	  VARDIR='${prefix}/var'	\
	  ETCDIR='${prefix}/etc'		\
	    /workspaces/Smallwebserver/yaws-yaws-2.3.1/scripts/gen-yaws-generated) > yaws_generated.erl

mime_types.erl: ../priv/mime.types $(EBIN_DIR)/mime_type_c.beam \
		$(EBIN_DIR)/yaws.beam
	$(AM_V_GEN)$(ERL) -noshell -pa $(EBIN_DIR) -s mime_type_c generate

$(EBIN_DIR)/yaws.app: ./yaws.app.src
	$(AM_V_at)$(MKDIR_P) $(EBIN_DIR)
	$(AM_V_GEN)$(AWK) -v src="$(MODULES)"				\
	"/{vsn, *{cmd,/ { 						\
		line = \$$0; 						\
		sub(/{vsn.*/, \"{vsn, \\\"2.3.1\\\"},\", line);	\
		print line; 						\
		next; 							\
	}								\
	/{modules,/ {							\
		line = \$$0;						\
		indent = index(line, \"[\"); 				\
		line = substr(line, 1, indent);				\
		print line;						\
		split(src, mods);					\
		mods_count = 0; 					\
		for (mod in mods) { 					\
			mods_count++; 					\
		} 							\
		prefix = sprintf(\"%*s\", indent, \" \");		\
		for (i = 1; i <= mods_count; i++) { 			\
			mod = mods[i]; 					\
			sub(/\.erl/, \"\", mod); 			\
			if (i != mods_count) 				\
				print prefix mod \",\";			\
			else 						\
				print prefix mod;			\
		}							\
		print prefix \"]},\";					\
		next;							\
	} 								\
	/\@APPDEPS\@/ {							\
		line = \$$0;						\
		sub(/\@APPDEPS\@/, \"$(APPDEPS)\", line);		\
		print line; 						\
		next;							\
	}								\
	{ print; }" $< > $@

$(EBIN_DIR)/yaws.appup: ./yaws.appup.src
	$(AM_V_at)$(MKDIR_P) $(EBIN_DIR)
	$(AM_V_GEN)sed -e "s/%VSN%/2.3.1/g" < $< > $@

$(EBIN_DIR)/%.beam: %.erl
	$(AM_V_at)$(MKDIR_P) $(EBIN_DIR)
	$(AM_V_at)$(ERLC) $(ERLC_FLAGS) -M $(PHONY_DEPS) -MF $(@:$(EBIN_DIR)/%.beam=$(DEPDIR)/%.Pbeam) -MT $@ $<
	$(AM_V_ERLC)$(ERLC) $(ERLC_FLAGS) -o $(EBIN_DIR) $<

$(EBIN_DIR):
	$(AM_V_at)$(MKDIR_P) $@

distclean-local:
	$(AM_V_at)rm -fr $(DEPDIR)

# Local Variables:
#    tab-width: 8
# End:

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
