[Unit]
Description=High performance HTTP 1.1 webserver written in Erlang
After=network.target remote-fs.target

[Service]
Type=forking
GuessMainPID=no

Environment="YAWS_CONF=--conf /workspaces/Smallwebserver/yaws-yaws-2.3.1/_inst/etc/yaws/yaws.conf"
#Environment="YAWS_ID=--id myserverid"

ExecStart=/workspaces/Smallwebserver/yaws-yaws-2.3.1/_inst/bin/yaws --daemon --heart $YAWS_CONF $YAWS_ID
ExecStartPost=/workspaces/Smallwebserver/yaws-yaws-2.3.1/_inst/bin/yaws $YAWS_ID --wait-started=10

ExecReload=/workspaces/Smallwebserver/yaws-yaws-2.3.1/_inst/bin/yaws $YAWS_ID --hup

ExecStop=/workspaces/Smallwebserver/yaws-yaws-2.3.1/_inst/bin/yaws $YAWS_ID --stop
ExecStopPost=/workspaces/Smallwebserver/yaws-yaws-2.3.1/_inst/bin/yaws $YAWS_ID --wait-stopped=10

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
